+    ranking, meta = service.recommend_dataframe(frame, "target")
+    assert len(ranking) == 4 and meta["profile"]["profile_sample_size"] == 10
+    assert ranking.utility.is_monotonic_decreasing
+    with pytest.raises(ValueError, match="V2"):
