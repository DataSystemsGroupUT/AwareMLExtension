new file mode 100644
index 0000000..c777a97
--- /dev/null
+++ b/awareml/protocol_v3/audit.py
@@ -0,0 +1,70 @@
+from __future__ import annotations
+
+from pathlib import Path
+import json
+import numpy as np
+import pandas as pd
+
+from .common import read_json, write_json
+
+
+def audit_existing(root, output):
+    root, output = Path(root), Path(output)
+    if output.exists():
+        raise ValueError("Audit output exists; choose a new path.")
+    paths = []
+    snapshot = root / "data/meta/snapshots/meta_logs_v2.json"
+    if snapshot.exists():
+        paths.append(snapshot)
+    artifacts = root / "artifacts"
+    if artifacts.exists():
+        paths.extend(sorted(artifacts.rglob("result.json")))
+    records, skipped = [], []
+    for path in paths:
+        try:
+            payload = read_json(path)
+            if isinstance(payload, dict) and isinstance(payload.get("records"), list):
+                raw = payload["records"]
+            elif isinstance(payload, dict) and isinstance(payload.get("result"), dict):
+                item = {**payload["result"], **payload.get("task", {})}
+                dataset = payload.get("dataset") or {}
+                item["available_rows"] = dataset.get("rows_in_evaluation_stream")
+                item.setdefault("max_samples_requested", 30000)
+                raw = [item]
+            else:
+                skipped.append({"path": str(path), "reason": "not_a_legacy_result_schema"})
+                continue
+            for item in raw:
+                available = item.get("available_rows") or (item.get("dataset_provenance") or {}).get("rows")
+                cap = item.get("max_samples_requested", 30000)
+                expected = min(int(available), int(cap)) if available is not None else int(cap)
+                samples = int(item.get("samples_processed", item.get("samples", 0)))
+                records.append({"source": str(path), "dataset_id": item.get("dataset_id", "unknown"),
+                                "framework": item["framework"], "seed": item.get("seed"),
+                                "expected_samples": expected, "samples_processed": samples,
+                                "runtime_sec": item["runtime_sec"], "completed_30k": expected == 30000 and samples == expected,
+                                "incomplete": samples < expected,
+                                "inferred_time_limit": samples < expected and float(item["runtime_sec"]) >= float(item.get("time_budget_sec", 60))})
+        except (OSError, ValueError, KeyError, TypeError) as exc:
+            skipped.append({"path": str(path), "reason": str(exc)})
+    output.mkdir(parents=True)
+    if not records:
+        result = {"status": "no_matching_legacy_results", "records": 0,
+                  "searched": [str(p) for p in paths], "skipped": skipped,
+                  "next_step": "Check the artifacts location; no runtime table or averages can be calculated from zero records."}
+        write_json(output / "audit.json", result)
+        return result
+    frame = pd.DataFrame(records)
+    frame.to_csv(output / "run_audit.csv", index=False)
+    # A completed-30k runtime is never imputed from a partial run.
+    frame["completed_30k_runtime"] = np.where(frame.completed_30k, frame.runtime_sec, np.nan)
+    summary = frame.groupby("framework", as_index=False).agg(
+        runs=("framework", "size"), completed_30k=("completed_30k", "sum"), incomplete_runs=("incomplete", "sum"),
+        mean_completed_30k_runtime_sec=("completed_30k_runtime", "mean"),
+        sd_completed_30k_runtime_sec=("completed_30k_runtime", "std"),
+        min_processed=("samples_processed", "min"), mean_processed=("samples_processed", "mean"), max_processed=("samples_processed", "max"))
+    summary.to_csv(output / "framework_runtime_summary.csv", index=False)
+    result = {"status": "audited", "records": len(records), "skipped": skipped,
+              "note": "Rows identify source files. Different campaign copies can repeat keys; do not add them together as independent executions."}
+    write_json(output / "audit.json", result)
+    return result
diff --git a/awareml/protocol_v3/campaign.py b/awareml/protocol_v3/campaign.py
new file mode 100644
index 0000000..401a6e3
--- /dev/null
+++ b/awareml/protocol_v3/campaign.py
@@ -0,0 +1,159 @@
+from __future__ import annotations
+
+import itertools
+import json
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+import yaml
+
+from .common import (ROOT, FRAMEWORKS, METADATA, SEEDS, canonical_csv_sha, code_fingerprint,
+                     digest, environment, read_json, sha256, utc_now, write_json)
+from .profile import ordinal_thresholds, profile_csv
+
+
+def source_inventory(root=ROOT):
+    root = Path(root)
+    registry = yaml.safe_load((root / "data/meta/registry/datasets_v1_47_audited.yaml").read_text())
+    rows = []
+    for item in registry["datasets"]:
+        rows.append({"dataset_id": item["dataset_id"], "path": str(root / "data/stream_datasets" / item["file_name"]),
+                     "target": item["target"], "cohort": "dev", "task_policy": "native_classification",
+                     "dataset_family": item.get("family") or "unknown", "source_type": item.get("source_type") or "unknown",
+                     "drift_type": item.get("drift_type") or "unknown", "sensitive_attribute": ""})
+    inventory = pd.read_csv(root / "configs/phase18_dataset_inventory_31.csv", keep_default_na=False)
+    for item in inventory.to_dict("records"):
+        rows.append({"dataset_id": item["dataset_id"], "path": str(root / "data/Testing Datasets" / item["filename"]),
+                     "target": item["target"], "cohort": "eval", "task_policy": item["task_policy"],
+                     **{key: item.get(key) or "unknown" for key in METADATA},
+                     "sensitive_attribute": item.get("sensitive_attribute") or ""})
+    return rows
+
+
+def preference_bank(count=100, seed=42):
+    rng = np.random.RandomState(int(seed))
+    rows = []
+    for i in range(int(count)):
+        k = int(rng.randint(1, 5))
+        active = rng.choice(4, size=k, replace=False)
+        values = np.zeros(4)
+        values[active] = rng.dirichlet(np.ones(k))
+        rows.append({"preference_id": i, **dict(zip(("accuracy", "runtime", "energy", "co2"), values.tolist()))})
+    return rows
+
+
+def prepare(directory, config_path, cohorts=("dev", "eval"), include_derived=False, inventory_path=None, smoke=False):
+    directory = Path(directory).resolve()
+    if directory.exists():
+        raise ValueError("Campaign directory already exists; choose a new name to preserve frozen evidence.")
+    cfg = read_json(config_path)
+    frameworks = list(cfg["frameworks"])
+    if not frameworks or len(set(frameworks)) != len(frameworks) or set(frameworks) - set(FRAMEWORKS):
+        raise ValueError("Choose unique supported framework IDs.")
+    seeds = [int(v) for v in cfg["seeds"]]
+    if len(set(seeds)) != len(seeds) or (not smoke and len(seeds) < 5):
+        raise ValueError("Production campaigns need at least five distinct seeds.")
+    if cfg.get("scientific_time_limit_sec") is not None:
+        raise ValueError("V3 scientific_time_limit_sec must be null.")
+    cap = cfg.get("max_samples")
+    if cap is not None and int(cap) < 1:
+        raise ValueError("Use null for full streams, or a positive common max_samples.")
+    if int(cfg["profile_size"]) < 1 or float(cfg["safety_timeout_sec"]) <= 0 or int(cfg["window_size"]) < 1:
+        raise ValueError("Prefix, window and safety timeout must be positive.")
+    if float(cfg["memory_poll_sec"]) <= 0 or int(cfg["cpu_threads"]) < 1 or int(cfg["preferences_per_dataset"]) < 1:
+        raise ValueError("Memory sampling, thread count and preference count must be positive.")
+    if cfg["tracking_mode"] != "machine":
+        raise ValueError("This isolated campaign explicitly implements machine-mode measurement.")
+    if not smoke and not cfg.get("track_energy", True):
+        raise ValueError("Production campaigns require measured energy; use --smoke for unmeasured checks.")
+    rows = pd.read_csv(inventory_path, keep_default_na=False).to_dict("records") if inventory_path else source_inventory()
+    if len({r["dataset_id"] for r in rows}) != len(rows):
+        raise ValueError("Inventory dataset IDs must be globally unique.")
+    selected, excluded = [], []
+    for r in rows:
+        if r["cohort"] not in cohorts:
+            continue
+        if r.get("task_policy", "native_classification") != "native_classification" and not include_derived:
+            excluded.append({"dataset_id": r["dataset_id"], "reason": "derived_task_not_in_primary_cohort"})
+            continue
+        selected.append(r)
+    if not selected:
+        raise ValueError("No datasets selected.")
+    missing = [r["path"] for r in selected if not Path(r["path"]).is_file()]
+    if missing:
+        raise FileNotFoundError("{} source CSVs are missing. First missing: {}. Use --cohort dev to prepare development alone.".format(len(missing), missing[0]))
+    source_hashes, seen = {}, {}
+    for r in selected:
+        value = canonical_csv_sha(r["path"])
+        if value in seen:
+            raise ValueError("Duplicate stream content: {} and {}".format(seen[value], r["dataset_id"]))
+        seen[value] = r["dataset_id"]
+        source_hashes[r["dataset_id"]] = value
+    # Even a separately prepared evaluation cohort must not duplicate a dev source.
+    if "eval" in cohorts:
+        for r in rows:
+            if r["cohort"] == "dev" and r["dataset_id"] not in source_hashes and Path(r["path"]).is_file():
+                value = canonical_csv_sha(r["path"])
+                if value in seen:
+                    raise ValueError("Evaluation source duplicates development stream {}".format(r["dataset_id"]))
+    directory.mkdir(parents=True)
+    streams = directory / "streams"
+    streams.mkdir()
+    datasets, profiles, tasks = [], [], []
+    for r in selected:
+        identifier = str(r["dataset_id"])
+        frame = pd.read_csv(r["path"], nrows=int(cap) if cap is not None else None, low_memory=False)
+        if frame.empty or frame.columns.duplicated().any():
+            raise ValueError("Empty dataset or duplicate columns: {}".format(identifier))
+        target = str(frame.columns[-1]) if r["target"] == "__LAST__" else str(r["target"])
+        if target not in frame or frame[target].isna().any():
+            raise ValueError("Missing target/labels: {}".format(identifier))
+        policy = r.get("task_policy") or "native_classification"
+        transform = None
+        if policy == "ordinal_quantile_max5":
+            # The thresholds are learned on the first labeled prefix only.
+            prefix = pd.read_csv(r["path"], nrows=int(cfg["profile_size"]))
+            thresholds = ordinal_thresholds(prefix[target])
+            original_target = target
+            target = "__awareml_v3_class__"
+            if target in frame:
+                raise ValueError("Reserved derived target column already exists.")
+            labels = np.digitize(pd.to_numeric(frame[original_target], errors="raise"), thresholds, right=True)
+            frame = frame.drop(columns=[original_target])
+            frame[target] = labels
+            transform = {"kind": "prefix_quantile_classification", "source_target": original_target,
+                         "thresholds": thresholds, "right": True, "fitted_on_first": min(int(cfg["profile_size"]), len(frame))}
+        elif policy != "native_classification":
+            raise ValueError("Unsupported task policy: {}".format(policy))
+        sensitive = str(r.get("sensitive_attribute") or "")
+        if sensitive and sensitive != target and sensitive in frame:
+            frame = frame.drop(columns=[sensitive])
+        rel = "streams/{}.csv".format(digest(identifier)[:16])
+        path = directory / rel
+        frame.to_csv(path, index=False, lineterminator="\n")
+        profile = profile_csv(path, target, int(cfg["profile_size"]))
+        meta = {key: str(r.get(key) or "unknown") for key in METADATA}
+        profiles.append({"dataset_id": identifier, "cohort": r["cohort"], **profile, **meta})
+        info = {"dataset_id": identifier, "cohort": r["cohort"], "stream_path": rel, "stream_sha256": sha256(path),
+                "source_sha256": sha256(r["path"]), "source_canonical_sha256": source_hashes[identifier],
+                "target": target, "expected_samples": len(frame), "task_policy": policy,
+                "target_transform": transform, "sensitive_feature_policy": "audit_only", **meta}
+        datasets.append(info)
+        for fw, seed in itertools.product(frameworks, seeds):
+            tasks.append({"task_id": len(tasks), "dataset_id": identifier, "framework": fw, "seed": seed,
+                          "cohort": r["cohort"], "expected_samples": len(frame)})
+    pd.DataFrame(profiles).to_csv(directory / "profiles.csv", index=False)
+    pd.DataFrame(tasks).to_csv(directory / "tasks.csv", index=False)
+    pd.DataFrame(preference_bank(cfg["preferences_per_dataset"], cfg["preference_seed"])).to_csv(directory / "preferences.csv", index=False)
+    write_json(directory / "datasets.json", datasets)
+    file_hashes = {str(p.relative_to(directory)).replace("\\", "/"): sha256(p)
+                   for p in sorted(directory.rglob("*")) if p.is_file()}
+    frozen = {"protocol": cfg, "mode": "smoke" if smoke else "production", "created_utc": utc_now(),
+              "cohorts": list(cohorts), "included_derived": bool(include_derived), "exclusions": excluded,
+              "dataset_count": len(datasets), "task_count": len(tasks), "file_hashes": file_hashes,
+              "code": code_fingerprint(), "preparation_environment": environment(),
+              "evidence_role": "revised_external_evaluation_reuses_previously_evaluated_cohort"}
+    manifest = {"campaign_sha256": digest(frozen), "frozen": frozen}
+    write_json(directory / "campaign.json", manifest)
+    return manifest
diff --git a/awareml/protocol_v3/cli.py b/awareml/protocol_v3/cli.py
new file mode 100644
index 0000000..351b469
--- /dev/null
+++ b/awareml/protocol_v3/cli.py
@@ -0,0 +1,207 @@
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+from .common import ROOT, FRAMEWORKS, clean, environment, load_campaign, read_json, write_json
+
+
+def parser():
+    p = argparse.ArgumentParser(description="AwareML V3 reproducible streaming experiments and meta-recommender")
+    sub = p.add_subparsers(dest="command", required=True)
+    q = sub.add_parser("status", help="Show software/environment and campaign/model readiness")
+    q.add_argument("--campaign")
+    q.add_argument("--bundle")
+    q = sub.add_parser("prepare", help="Freeze stream prefixes, profiles, tasks and preferences without executing frameworks")
+    q.add_argument("--campaign", required=True)
+    q.add_argument("--config", default=str(ROOT / "configs/stream_protocol_v3.json"))
+    q.add_argument("--cohort", choices=("dev", "eval", "both"), default="dev")
+    q.add_argument("--include-derived", action="store_true")
+    q.add_argument("--inventory", help="Optional CSV with dataset_id,path,target,cohort,task_policy")
+    q.add_argument("--smoke", action="store_true")
+    q = sub.add_parser("run", help="Run one task, or serial tasks, with an external safety watchdog")
+    q.add_argument("--campaign", required=True)
+    q.add_argument("--task-id", type=int)
+    q.add_argument("--serial", action="store_true")
+    q.add_argument("--resume", action="store_true", help="Skip any task with an existing attempt; never rerun failures silently")
+    q.add_argument("--retry", action="store_true", help="Preserve a new attempt for the explicitly chosen task")
+    q.add_argument("--dedicated-host", action="store_true", help="Declare that this workstation is dedicated to one measured workload")
+    q = sub.add_parser("worker", help=argparse.SUPPRESS)
+    q.add_argument("--campaign", required=True)
+    q.add_argument("--task-id", type=int, required=True)
+    q.add_argument("--attempt", required=True)
+    q = sub.add_parser("collect", help="Validate and aggregate complete runs, retaining failures and all attempts")
+    q.add_argument("--campaign", required=True)
+    q.add_argument("--output", required=True)
+    q.add_argument("--latest-attempt", action="store_true")
+    q.add_argument("--portfolio", choices=("primary", "extended"), default="primary")
+    q = sub.add_parser("train", help="Run nested LODO, final model selection and frozen V3 bundle creation")
+    q.add_argument("--collection", required=True)
+    q.add_argument("--output", required=True)
+    q.add_argument("--portfolio", choices=("primary", "extended"), default="primary")
+    q.add_argument("--features", choices=("prefix", "metadata", "both"), default="both")
+    q.add_argument("--complete-case", action="store_true")
+    q.add_argument("--cache", help="Optional shared fit-cache directory for interruption recovery into a new output bundle")
+    q = sub.add_parser("evaluate", help="Evaluate nested development predictions or a separate evaluation cohort")
+    q.add_argument("--bundle", required=True)
+    q.add_argument("--collection", help="Omit for nested development evaluation")
+    q.add_argument("--output", required=True)
+    q.add_argument("--complete-case", action="store_true")
+    q = sub.add_parser("ablation", help="Paired comparison of prefix-only and metadata evaluations")
+    q.add_argument("--prefix", required=True)
+    q.add_argument("--metadata", required=True)
+    q.add_argument("--output", required=True)
+    q = sub.add_parser("recommend", help="Use a trained prefix-only V3 bundle on a labeled CSV prefix")
+    q.add_argument("--bundle", required=True)
+    q.add_argument("--csv", required=True)
+    q.add_argument("--target", required=True)
+    q.add_argument("--weights", nargs=4, type=float, default=[1, 1, 1, 1], metavar=("ACC", "TIME", "ENERGY", "CO2"))
+    q.add_argument("--output", required=True)
+    q = sub.add_parser("audit-existing", help="Audit legacy artifacts; zero matching files produces a clear report")
+    q.add_argument("--root", default=str(ROOT))
+    q.add_argument("--output", required=True)
+    q = sub.add_parser("submit", help="Submit exclusive-node Slurm array tasks; no fixed node names")
+    q.add_argument("--campaign", required=True)
+    q.add_argument("--concurrency", type=int, default=4)
+    q.add_argument("--partition")
+    q.add_argument("--constraint", help="Cluster hardware constraint to keep CPU hardware homogeneous")
+    q.add_argument("--dry-run", action="store_true")
+    q = sub.add_parser("smoke", help="Unmeasured, explicitly ineligible ASML/AutoClass binary and multiclass integration checks")
+    q.add_argument("--output", required=True)
+    q.add_argument("--frameworks", nargs="+", choices=FRAMEWORKS, default=["AutoStreamML", "AutoClass"])
+    return p
+
+
+def smoke(output, frameworks=("AutoStreamML", "AutoClass")):
+    import numpy as np
+    import pandas as pd
+    from .campaign import prepare
+    from .execution import run_task
+    output = Path(output).resolve()
+    output.mkdir(parents=True, exist_ok=False)
+    rng = np.random.RandomState(42)
+    rows = []
+    for classes in (2, 3):
+        path = output / ("stream_{}.csv".format(classes))
+        x = rng.normal(size=160)
+        y = (x > 0).astype(int) if classes == 2 else np.digitize(x, [-.4, .4])
+        pd.DataFrame({"x": x, "z": rng.normal(size=160), "target": y}).to_csv(path, index=False)
+        rows.append({"dataset_id": "smoke_{}classes".format(classes), "path": str(path), "target": "target",
+                     "cohort": "dev", "task_policy": "native_classification"})
+    pd.DataFrame(rows).to_csv(output / "inventory.csv", index=False)
+    cfg = read_json(ROOT / "configs/stream_protocol_v3.json")
+    cfg.update(frameworks=list(frameworks), seeds=[42], max_samples=160, profile_size=30,
+               window_size=40, track_energy=False, safety_timeout_sec=120)
+    write_json(output / "smoke_config.json", cfg)
+    manifest = prepare(output / "campaign", output / "smoke_config.json", cohorts=("dev",), inventory_path=output / "inventory.csv", smoke=True)
+    results = [run_task(output / "campaign", i) for i in range(manifest["frozen"]["task_count"])]
+    report = {"status": "pass" if all(r["status"] == "completed" and r["samples_processed"] == 160 for r in results) else "fail",
+              "production_evidence": False, "tested": [{"task": r["task"], "status": r["status"], "error": r.get("error"), "samples": r.get("samples_processed")} for r in results]}
+    write_json(output / "smoke_report.json", report)
+    return report
+
+
+def main(argv=None):
+    p = parser()
+    a = p.parse_args(argv)
+    if a.command == "status":
+        result = {"software_version": "3.0.0", "environment": environment(), "old_frozen_results_are_not_V3_results": True}
+        if a.campaign:
+            m = load_campaign(a.campaign)
+            result["campaign"] = {"mode": m["frozen"]["mode"], "tasks": m["frozen"]["task_count"], "sha256": m["campaign_sha256"]}
+        if a.bundle:
+            from .models import load_bundle
+            m, _ = load_bundle(a.bundle)
+            result["bundle"] = {"feature_set": m["feature_set"], "training_datasets": len(m["training_dataset_ids"])}
+    elif a.command == "prepare":
+        from .campaign import prepare
+        cohorts = ("dev", "eval") if a.cohort == "both" else (a.cohort,)
+        m = prepare(a.campaign, a.config, cohorts, a.include_derived, a.inventory, a.smoke)
+        result = {"campaign": str(Path(a.campaign).resolve()), "sha256": m["campaign_sha256"],
+                  "datasets": m["frozen"]["dataset_count"], "tasks": m["frozen"]["task_count"], "mode": m["frozen"]["mode"]}
+    elif a.command == "worker":
+        from .execution import worker
+        result = worker(a.campaign, a.task_id, a.attempt)
+    elif a.command == "run":
+        if bool(a.serial) == (a.task_id is not None):
+            p.error("Choose exactly one of --serial or --task-id.")
+        if a.serial and a.retry:
+            p.error("Retries must identify a single task, preserving an explicit retry decision.")
+        from .execution import run_task
+        if a.serial:
+            m = load_campaign(a.campaign)
+            counts = {"completed": 0, "failed": 0, "skipped_existing": 0}
+            for i in range(m["frozen"]["task_count"]):
+                previous = list((Path(a.campaign) / "runs" / "task_{:05d}".format(i)).glob("attempt_*"))
+                if a.resume and previous:
+                    counts["skipped_existing"] += 1
+                    continue
+                r = run_task(a.campaign, i, a.dedicated_host)
+                key = "completed" if r["status"] == "completed" else "failed"
+                counts[key] += 1
+                print("Task {}: {}".format(i, r["status"]), flush=True)
+            result = counts
+        else:
+            r = run_task(a.campaign, a.task_id, a.dedicated_host, a.retry)
+            result = {k: r.get(k) for k in ("task", "status", "eligible", "stop_reason", "samples_processed", "error")}
+    elif a.command == "collect":
+        from .collection import collect
+        m = collect(a.campaign, a.output, a.latest_attempt, a.portfolio)
+        result = {k: m["frozen"][k] for k in ("expected_datasets", "complete_datasets", "excluded_incomplete_datasets", "task_status_counts", "hardware_issues")}
+    elif a.command == "train":
+        from .models import train_bundle
+        kinds = (False, True) if a.features == "both" else (a.features == "metadata",)
+        result = []
+        for metadata in kinds:
+            directory = Path(a.output) / (a.portfolio + ("_metadata" if metadata else "_prefix"))
+            m = train_bundle(a.collection, directory, a.portfolio, metadata, a.complete_case, a.cache)
+            result.append({"bundle": str(directory), "features": m["feature_set"], "training_datasets": len(m["training_dataset_ids"])})
+    elif a.command == "evaluate":
+        from .evaluation import evaluate
+        result = evaluate(a.bundle, a.output, a.collection, a.complete_case)
+    elif a.command == "ablation":
+        from .evaluation import compare_ablation
+        result = compare_ablation(a.prefix, a.metadata, a.output)
+    elif a.command == "recommend":
+        import pandas as pd
+        from .service import V3Recommender
+        service = V3Recommender(a.bundle)
+        frame = pd.read_csv(a.csv, nrows=int(service.manifest["profile_size"]))
+        ranked, meta = service.recommend_dataframe(frame, a.target, a.weights)
+        result = {"ranking": ranked.to_dict("records"), "metadata": meta}
+        write_json(a.output, result)
+    elif a.command == "audit-existing":
+        from .audit import audit_existing
+        result = audit_existing(a.root, a.output)
+    elif a.command == "submit":
+        m = load_campaign(a.campaign)
+        if a.concurrency < 1:
+            p.error("Concurrency must be positive.")
+        cfg = m["frozen"]["protocol"]
+        log_dir = Path(a.campaign).resolve() / "slurm"
+        log_dir.mkdir(parents=True, exist_ok=True)
+        scheduler_seconds = int(cfg["safety_timeout_sec"]) + 600
+        duration = "{:02d}:{:02d}:{:02d}".format(scheduler_seconds // 3600, scheduler_seconds // 60 % 60, scheduler_seconds % 60)
+        command = ["sbatch", "--exclusive", "--mem=0", "--cpus-per-task={}".format(cfg["cpu_threads"]),
+                   "--time=" + duration, "--array=0-{}%{}".format(m["frozen"]["task_count"] - 1, a.concurrency),
+                   "--output=" + str(log_dir / "%A_%a.out"), "--error=" + str(log_dir / "%A_%a.err")]
+        if a.partition:
+            command.append("--partition=" + a.partition)
+        if a.constraint:
+            command.append("--constraint=" + a.constraint)
+        command += [str(ROOT / "hpc/protocol_v3/run_task.sbatch"), str(Path(a.campaign).resolve()), sys.executable]
+        result = {"command_argv": command, "submitted": False}
+        if not a.dry_run:
+            result.update(submitted=True, response=subprocess.check_output(command, cwd=str(ROOT), text=True).strip())
+    elif a.command == "smoke":
+        result = smoke(a.output, a.frameworks)
+    print(json.dumps(clean(result), indent=2, allow_nan=False))
+    if a.command == "smoke" and result["status"] != "pass":
+        return 1
+    if a.command == "run" and ((a.serial and result["failed"]) or (not a.serial and result.get("status") != "completed")):
+        return 1
+    return 0
